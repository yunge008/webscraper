{
  "manifest_version": 3,
  "name": "web scraper rebuild",
  "short_name": "web scraper rebuild",
  "description": "增加TK商品评论批量采集（当前筛选 / 指定商品ID / Excel列表、评价图、分批续采）",
  "version": "1.108.1",
  "minimum_chrome_version": "120",
  "default_locale": "en",
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "24": "images/icon24.png",
      "32": "images/icon32.png"
    },
    "default_title": "web scraper rebuild"
  },
  "background": {
    "service_worker": "background_script.js"
  },
  "devtools_page": "devtools_init_page.html",
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.tiktokshop.com/*",
        "https://*.tiktokshopglobalselling.com/*",
        "https://*.tiktokglobalshop.com/*"
      ],
      "js": [
        "tiktok_capture_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "permissions": [
    "tabs",
    "notifications",
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "scripting",
    "sidePanel",
    "webRequest",
    "downloads"
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
